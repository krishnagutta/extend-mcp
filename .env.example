# extend-mcp configuration — copy to .env and fill in. .env is gitignored.

# Workday Developer Platform system-user credentials (required).
# Create a system user at https://developer.workday.com -> your org -> System Users.
WDCLI_CLIENT_ID=your_client_id
WDCLI_CLIENT_SECRET=your_client_secret

# Production tenant alias (REQUIRED). Deploys to this alias are refused by the
# production-deploy guard. The server refuses to start if this is unset, so the
# guard can never be silently disarmed. Example: acme
EXTEND_PROD_TENANT=your_prod_tenant_alias

# Advisory allowlist of known-safe, non-production tenant aliases (optional,
# comma-separated). Surfaced in deploy output; does not gate deploys.
# Example: acme-sb,acme1,acme_preview
EXTEND_SAFE_TENANTS=

# Local working directory for downloaded/edited apps (optional).
# Defaults to ~/extend-workspace.
EXTEND_WORK_DIR=
