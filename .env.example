# extend-mcp configuration — copy to .env and fill in. .env is gitignored.

# Workday Developer Platform system-user credentials (OPTIONAL).
# Set BOTH to let the server re-login as a system user automatically. Leave BOTH
# empty to use a browser OAuth session instead: run `wdcli auth login` yourself in
# the same HOME / WDCLI_CONFIG_DIR the server uses; the server then never logs in.
WDCLI_CLIENT_ID=your_client_id
WDCLI_CLIENT_SECRET=your_client_secret

# Production tenant alias (REQUIRED). Deploys to this alias are refused by the
# production-deploy guard. The server refuses to start if this is unset, so the
# guard can never be silently disarmed. Example: acme
EXTEND_PROD_TENANT=your_prod_tenant_alias

# Deploy allowlist (optional, comma-separated — STRONGLY recommended).
# When set, it is ENFORCED: deploy_extend_app refuses any tenant not listed.
# List only DEVELOPMENT tenants — sandbox tenants refresh weekly with
# PRODUCTION data and hold real employee records, so "not production" is not
# the same as "safe". When unset, only the production block applies.
# Example: acme_dev1,acme_dev2
EXTEND_SAFE_TENANTS=

# Local working directory for downloaded/edited apps (optional).
# Defaults to ~/extend-workspace.
EXTEND_WORK_DIR=

# Learnings directory (optional). Defaults to docs/knowledge/learnings/ in this
# repo. Set it when this server is registered a second time for another client
# or engagement so those learnings never land in this public repo.
EXTEND_LEARNINGS_DIR=
